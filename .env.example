# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control

# Example API Configuration (if needed in future)
# API_KEY=your_api_key_here
# API_SECRET=your_api_secret_here

# Example Service URLs (if needed)
# SERVICE_URL=https://your-service.com
# WEBHOOK_URL=https://your-webhook-endpoint.com

# Example Contact Information (if needed)
# CONTACT_EMAIL=your-email@example.com
# PHONE_NUMBER=+1234567890

# Example Social Media (if needed)
# INSTAGRAM_URL=https://instagram.com/your_handle
# YOUTUBE_URL=https://youtube.com/@your_channel
# SOUNDCLOUD_URL=https://soundcloud.com/your_profile
